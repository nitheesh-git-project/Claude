# Local development only (`next dev` loads this; `.env.production` covers
# the deployed site). Arms the debug bar's "Reset data" button so a test
# round can be cleared without deleting rows by hand.
#
# ⚠️  This machine's dev server talks to whatever NEXT_PUBLIC_SUPABASE_URL
# points at. If that is the live project, this button empties the live
# database -- every patient, session, purchase and catalog row -- for any
# signed-in full-scope admin who types "RESET ALL DATA". There is no undo.
#
# DELETE THIS FILE BEFORE REAL PATIENTS EXIST.
ALLOW_DEBUG_DATA_RESET=true
