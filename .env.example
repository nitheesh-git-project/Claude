# Copy this file to .env.local and fill in real values.

# Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project: Settings -> API Keys -> Secret keys.
# Server-only — bypasses Row Level Security. Never expose to the browser
# (never prefix with NEXT_PUBLIC_) and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay: Dashboard -> Settings -> API Keys.
# Use Test Mode keys (rzp_test_...) until the full payment flow has been
# verified end to end — only switch to Live Mode keys after that.
# The Key ID is not secret (it's sent to the browser to open the checkout
# widget); the Key Secret must stay server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret: Dashboard -> Settings -> Webhooks.
# Create a webhook pointing at https://<your-domain>/api/razorpay/webhook
# subscribed to payment.captured (payment.authorized and payment.failed are
# recorded too), and paste the secret you set there here. This is a
# different secret from RAZORPAY_KEY_SECRET above.
#
# Without it /api/razorpay/webhook answers 503 and payment confirmation
# falls back to the browser callback alone -- which means a patient who
# pays and closes the tab before returning to the site leaves a paid order
# against an unpaid booking. Set it in every environment that takes real
# payments.
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar / Meet integration. OAuth2 Client credentials from Google
# Cloud Console (Web application type), a dedicated Calendar's ID, and a
# refresh token obtained by running `node scripts/get-google-refresh-token.mjs`
# once (see that script's header comment for the one-time setup steps).
# The authorizing Google account acts as the meeting organizer.
#
# Enable BOTH the Google Calendar API and the Google Meet API on the Cloud
# project. The refresh token carries two scopes: calendar.events creates the
# session's event and Meet link, and meetings.space.settings is what opens
# each meeting so neither the patient nor the therapist is held in a waiting
# room. A token minted before that second scope keeps creating events and
# returns 403 on the access change -- sessions then show under
# Settings -> System Health -> Waiting Room until the script is re-run.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Optional — a Supabase Personal Access Token (supabase.com -> Account ->
# Access Tokens), NOT the service role key or DB password. Only needed to
# run `node scripts/run-schema.mjs`, which applies supabase/schema.sql over
# the Supabase Management API instead of pasting it into the SQL Editor.
SUPABASE_ACCESS_TOKEN=

# Pre-launch testing only. When set to exactly "true", the debug bar's
# "Reset data" button works: it empties every table and deletes every
# non-admin account, keeping only admin logins. Unset (the default), the
# route answers 404 and the button reports that it is switched off.
#
# NEVER set this on a deployment holding real patient data. It is separate
# from NEXT_PUBLIC_SHOW_DEBUG_NAV on purpose -- the debug bar is on in every
# environment while the app is pre-launch, so reusing that flag would arm a
# data wipe for anyone who can reach the page.
ALLOW_DEBUG_DATA_RESET=

# Optional. The debug bar's kill switch. The bar is on everywhere by default
# (src/lib/debugNavVisible.ts) because the app is pre-launch; set this to
# exactly "false" to hide it without touching code. At real launch, delete
# the bar rather than switching it off -- this flag is public, so the routes
# it names are readable by anyone.
NEXT_PUBLIC_SHOW_DEBUG_NAV=
