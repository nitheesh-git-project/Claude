    "test:a11y": "playwright test e2e/accessibility.spec.ts --project desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run build",
    "check:grants": "node scripts/check-function-grants.mjs",
    "start:cluster": "node scripts/start-cluster.mjs",
    "check:concurrency": "node scripts/concurrency-checks.mjs",
    "check:authorization": "node scripts/authorization-checks.mjs",
    "check:search-path": "node scripts/check-search-path.mjs",
    "check:rls-initplan": "node scripts/check-rls-initplan.mjs",
    "check:icon-styles": "node scripts/check-icon-styles.mjs",
    "build:rules-index": "node scripts/build-rules-index.mjs",
    "check:coverage": "node scripts/ci/check-coverage-manifest.mjs",
    "check:context-budget": "node scripts/ci/check-context-budget.mjs",
    "check:merge-ready": "node scripts/ci/merge-ready.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
