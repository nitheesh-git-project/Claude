{
  "name": "moverestore-physio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run check:realtime && npm run check:grants && npm run check:search-path && npm run check:rls-initplan && npm run check:icon-styles && eslint",
    "check:realtime": "node scripts/check-realtime-coverage.mjs",
    "seed:qa": "node scripts/seed-qa-accounts.mjs",
