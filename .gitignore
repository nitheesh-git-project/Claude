# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from the .claude/skills tooling
__pycache__/
*.pyc

# graphify knowledge-graph output. graph.json and GRAPH_REPORT.md are
# committed on purpose -- CI refreshes them on every merge to main
# (.github/workflows/graphify.yml) so a fresh clone has a current graph.
# Everything else graphify emits is bulky, regenerable, and stays out:
# the interactive viz, the exported graph formats, the wiki/vault, and any
# source material pulled in by `graphify add`.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Local QA scratch (session-only; never committed)
.qa-*
