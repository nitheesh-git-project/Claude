# Pre-launch only. Restores the debug "Jump to page" bar on production
# builds (`next build` + `next start`, and the deployed site), which is
# otherwise hidden because the root layout defaults it off whenever
# NODE_ENV === "production".
#
# ⚠️  This flag is PUBLIC — it ships in the browser bundle and the bar
# renders for every visitor, not only for us. The bar lists every route,
# protected dashboards included, so it is the one deliberate exception to
# the rule that the back office is never named to anyone outside it
# (/admin/login and /admin/dashboard appear in its dropdown).
#
# DELETE THIS FILE (or set the value to "false") BEFORE REAL LAUNCH.
NEXT_PUBLIC_SHOW_DEBUG_NAV=true

# ALLOW_DEBUG_DATA_RESET is deliberately NOT set here. This file used to
# carry it, which armed the bar's "Reset data" button against the live
# database: one full-scope admin typing "RESET ALL DATA" emptied every
# table, with no undo. Left unset, the button still renders but
# /api/admin/debug-reset answers 404, which is what "Reset is switched off
# on this server" means in the UI. Restoring the bar is not a reason to
# re-arm the wipe — set it in the server environment only, deliberately,
# and only against a throwaway project.
