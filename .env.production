# Temporary override so the debug "Jump to page" bar shows on the live
# Vercel deployment too, not just local dev — requested to make manually
# checking each published change easier.
#
# ⚠️  REMINDER: delete this file (or flip the value to "false") before real
# public launch. This is a nav shortcut into every page, including
# protected dashboards' route paths — fine for our own testing, not
# something real visitors should see.
NEXT_PUBLIC_SHOW_DEBUG_NAV=true

# Arms the debug bar's "Reset data" button on the deployed site. Without it
# the button renders but the route answers 404, which is what "Reset is
# switched off on this server" means.
#
# ⚠️  This lets any signed-in FULL-scope admin empty the entire database --
# every patient, session, purchase and catalog row -- after typing
# "RESET ALL DATA". Admin logins are the only thing that survives, and there
# is no undo. It is here because the app is still in testing.
#
# DELETE THIS LINE BEFORE REAL PATIENTS EXIST, along with the debug bar
# above and the debug_reset_all_data() function in supabase/schema.sql.
ALLOW_DEBUG_DATA_RESET=true
