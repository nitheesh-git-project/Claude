# Temporary override so the debug "Jump to page" bar shows on the live
# Vercel deployment too, not just local dev — requested to make manually
# checking each published change easier.
#
# ⚠️  REMINDER: delete this file (or flip the value to "false") before real
# public launch. This is a nav shortcut into every page, including
# protected dashboards' route paths — fine for our own testing, not
# something real visitors should see.
NEXT_PUBLIC_SHOW_DEBUG_NAV=true
